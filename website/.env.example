# --- optional: contact form (Resend) ---
# Unset, the contact form's server action returns a graceful "not configured"
# result instead of sending mail — see actions/contact-action.ts. Nothing
# else in this app reads env vars.
RESEND_API_KEY=
CONTACT_TO_EMAIL=         # defaults to a placeholder inbox if unset
CONTACT_FROM_EMAIL=       # defaults to a placeholder sender if unset
