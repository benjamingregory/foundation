# ── Access control ──────────────────────────────────────────────────────────
# The ONLY thing gating this app. DATABASE_URL below connects as the
# `postgres` role, which has BYPASSRLS — anyone who gets past this domain
# check can read every user's data. Exact-match, case-insensitive, one
# domain. Unset denies every sign-in (fail closed).
ADMIN_EMAIL_DOMAIN=example.com

# ── Supabase ────────────────────────────────────────────────────────────────
# Same project as the product app (web/). Backs the email+password sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Same Postgres as the product app. Read-only in practice: this app never
# writes — see db/client.ts and db/schema.ts.
DATABASE_URL=
