node_modules/
.next/
.env
.env.local
.env*.local
*.log
.DS_Store
.claude/settings.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Design skills are installed, not vendored — see skills-lock.json and the
# project-init skill. `npx skills add` writes the payload to .agents/skills/,
# symlinks it into .claude/skills/, AND drops a second copy in agent/skills/
# for harnesses that look there. All three must be ignored: missing agent/ let
# 145 skill files get swept into a new project's bootstrap commit, which is the
# exact thing pinning-instead-of-vendoring exists to prevent. project-init is
# ours, so it stays tracked.
.agents/
agent/
.claude/skills/*
!.claude/skills/project-init/
